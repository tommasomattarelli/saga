# Database
DATABASE_URL=postgresql+asyncpg://saga:saga@db:5432/saga

# Auth
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_ENCRYPTION_KEY=change-me-to-a-random-256-bit-key

# AI Providers — set the keys for the providers you want to use.
# You only need the key(s) for the provider(s) you actually use.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Local OpenAI-compatible server (llama.cpp, vLLM, LM Studio, ...).
# LOCAL_MODEL_URL=http://localhost:8080/v1

# ---------------------------------------------------------------------------
# Model configuration (ADR 0018)
#
# There are no global model tiers anymore. Instance policy — allowed providers,
# named local endpoints, server-key fallback consent — and the default
# provider/model live in saga.config.yaml. Each user picks one provider and one
# model in the app settings and enters their own API keys (BYOAK).
#
# These variables were removed from the project; a leftover value is ignored.
# Delete them if you still have them:
#   SAGA_GLOBAL_PROVIDER, SAGA_GLOBAL_MODEL_HIGH/MEDIUM/LOW,
#   SAGA_MODEL_{CALL_TYPE}_{TIER}[_PROVIDER]
# ---------------------------------------------------------------------------


# App
LOG_LEVEL=info
