# Database
DATABASE_URL=postgresql+asyncpg://saga:saga@db:5432/saga
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_ENCRYPTION_KEY=change-me-to-a-random-256-bit-key

# AI Providers — set the keys for the providers you want to use.
# You only need the key(s) for the provider(s) you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Global Model Configuration (optional)
# Override the defaults in backend/app/ai/model_config.yaml from here.
#
# Three reasoning tiers are used across the game:
#   HIGH   — premium model (boss fights, dramatic reveals, key moments)
#   MEDIUM — standard model (normal gameplay)
#   LOW    — budget model (background tasks, simple queries)
#
# Quick-start presets:
#
#   ── Gemini only ──────────────────────────────────────────────────────────
#   SAGA_GLOBAL_PROVIDER=google
#   SAGA_GLOBAL_MODEL_HIGH=gemini-2.5-pro
#   SAGA_GLOBAL_MODEL_MEDIUM=gemini-2.0-flash
#   SAGA_GLOBAL_MODEL_LOW=gemini-2.0-flash-lite
#
#   ── OpenAI only ──────────────────────────────────────────────────────────
#   SAGA_GLOBAL_PROVIDER=openai
#   SAGA_GLOBAL_MODEL_HIGH=gpt-4o
#   SAGA_GLOBAL_MODEL_MEDIUM=gpt-4o
#   SAGA_GLOBAL_MODEL_LOW=gpt-4o-mini
#
#   ── Mixed (OpenAI narration, Gemini companions) ───────────────────────────
#   Leave these blank and use the fine-grained overrides instead:
#   SAGA_MODEL_DM_NARRATION_HIGH=gpt-4o
#   SAGA_MODEL_COMPANION_DIALOGUE_DEFAULT=gemini-2.5-pro
#
# Fine-grained overrides always take priority over the globals above.
# Pattern: SAGA_MODEL_{CALL_TYPE}_{TIER}
# Call types: DM_NARRATION, COMPANION_DIALOGUE, NPC_BEHAVIOR, WORLD_SIM,
#             MEMORY_COMPRESSION, EMBEDDING
# Tiers:      HIGH, MEDIUM, LOW (DM_NARRATION only), DEFAULT (all others)
#
# Use the _PROVIDER suffix to override the provider for a specific call.
# Example: SAGA_MODEL_DM_NARRATION_HIGH_PROVIDER=openai
# ---------------------------------------------------------------------------

SAGA_GLOBAL_PROVIDER=
SAGA_GLOBAL_MODEL_HIGH=
SAGA_GLOBAL_MODEL_MEDIUM=
SAGA_GLOBAL_MODEL_LOW=


# App
LOG_LEVEL=info
