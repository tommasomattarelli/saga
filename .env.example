# Database
DATABASE_URL=postgresql+asyncpg://saga:saga@localhost:5432/saga
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_ENCRYPTION_KEY=change-me-to-a-random-256-bit-key

# AI Providers (users configure their own in the UI, these are fallback/cloud defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# App
APP_MODE=community
DEFAULT_LANGUAGE=en
TELEMETRY_ENABLED=false
LOG_LEVEL=info

# Cloud-only
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
