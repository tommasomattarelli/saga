{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SAGA backend (uvicorn, no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://saga:saga@localhost:5432/saga",
        "SAGA_ENVIRONMENT": "dev"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "SAGA single test (pytest, needs test DB)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "tests/integration/test_quest_persistence.py::test_a_real_turn_persists_one_record_per_id_and_drives_the_next_prompt"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://saga:saga@localhost:5432/saga",
        "TEST_DATABASE_URL": "postgresql+asyncpg://saga_test:saga_test@localhost:5433/saga_test",
        "SAGA_ENVIRONMENT": "test"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
